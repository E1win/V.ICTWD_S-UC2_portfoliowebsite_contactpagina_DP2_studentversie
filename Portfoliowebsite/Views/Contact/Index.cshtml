@model ContactModel
@{
    ViewData["Title"] = "Contact";
}

<h1>Contact</h1>

<form id="contactForm" asp-action="ContactRequest" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="validation-error"
         role="alert"
         aria-live="assertive">
    </div>

    <div class="hp">
        <label for="website">Laat dit veld leeg</label>
        <input type="text" id="website" name="website" value="" tabindex="-1" />
    </div>
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" placeholder="Naam" />
        <span asp-validation-for="Name" class="error"></span>
    </div>
    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" placeholder="naam@domein.nl" />
        <span asp-validation-for="Email" class="error"></span>
    </div>
    <div>
        <label asp-for="Subject"></label>
        <input asp-for="Subject" placeholder="Onderwerp" />
        <span asp-validation-for="Subject" class="error"></span>
    </div>
    <div>
        <label asp-for="Message"></label>
        <textarea asp-for="Message" rows="5" placeholder="Je bericht"></textarea>
        <span asp-validation-for="Message" class="error"></span>
    </div>
    <button type="submit" class="send-button"></button>
</form>